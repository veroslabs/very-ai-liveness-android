<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap the button to start a liveness check."
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/showErrorSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show in-SDK error page"
        android:checked="true"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/showSuccessSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show success page"
        android:checked="true"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disclosure message (HTML allowed):"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/privacyMessageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="6"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:hint="Disclosure message (blank = none)"
        android:textSize="13sp"
        android:background="#F0F0F0"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/fontSizeInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Disclosure font size in sp (blank = default)"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/scanTimeoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="Scan timeout in seconds (blank = default 10s)"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Custom scan strings (blank = SDK localized default):"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/showYourHandInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text|textNoSuggestions"
        android:hint="showYourHand — replaces Show your hand"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/connectDotsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text|textNoSuggestions"
        android:hint="connectDots — replaces Connect the dots"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/startLivenessButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Liveness Check"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/resultLabel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:padding="12dp"
        android:background="#F5F5F5"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="top" />

</LinearLayout>
